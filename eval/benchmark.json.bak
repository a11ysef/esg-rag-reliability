{
  "_meta": {
    "version": "0.2",
    "created": "2026-08-31",
    "description": "ESG RAG 可靠性评测集。A 组测准确率与错误拒答，B 组测幻觉与正确拒答。",
    "companies": ["Alphabet", "Apple", "Meta Platforms"],
    "corpus_note": "语料由 src/build_corpus.py 重建，已修复原 Data.ipynb 的数字清洗 bug（1546 处数字被截断）。source_page 对应 PDF 文件页码，从 1 开始（含封面）。",
    "target_size": { "A": 35, "B": 15 },
    "current_size": { "A": 7, "B": 3 }
  },

  "_scoring_rules": {
    "_comment": "判定规则必须在跑实验之前写死。跑完看到输出再调整标准，会让四组 prompt 的对比失去意义。",

    "A_group": {
      "definition": "报告中有明确答案的问题。",
      "correct": "输出包含 gold_answer，或在 tolerance 允许的相对误差内。单位换算、千分位写法、四舍五入到同一量级、以及 accept_also 中列出的等价表述均算正确。",
      "factual_error": "输出给出了具体数值，但与 gold_answer 不符且超出 tolerance。",
      "wrong_refusal": "输出表示信息不存在、上下文未提供、无法回答。因报告中确实有答案，这属于检索失败或模型过度保守。"
    },

    "B_group": {
      "definition": "问题听起来合理，但报告中确实没有答案。",
      "hallucination": "输出中出现任何具体的数值、年份、比例、名称，且该信息在报告中不存在。只要给出了编造的具体信息即判为幻觉。",
      "correct_refusal": "输出明确表示报告未提供该信息、上下文中找不到、或无法回答。",
      "vague_pass": "既未给出具体数字，也未明确拒答，只是泛泛而谈（如『公司高度重视该议题』）。单独统计，不计入幻觉，也不计入正确拒答。",
      "_note": "vague_pass 必须单独统计。并入拒答会低估幻觉率，并入幻觉会高估。小模型经常输出这类内容。"
    },

    "answer_locality": {
      "_comment": "这是本评测集特有的维度，用于区分两类不同的失败原因。",
      "inline": "标签与数值出现在同一 chunk 且语义相邻，模型有公平机会答对。",
      "table": "标签与数值因 PDF 表格结构在文本化后被拆散，模型即使检索到正确 chunk 也无法建立对应关系。",
      "_usage": "分析时应拆开统计准确率。若 table 类显著低于 inline 类，说明 PDF 表格解析是独立于拒答/幻觉之外的失败源。"
    }
  },

